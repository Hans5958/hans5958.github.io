---
import { Icon } from "astro-icon/components"
import A from "../Anchor.astro"
import type { AccountData } from "@/data/accounts.ts"

const {data: item, ...props} = Astro.props as { data: AccountData }

let note = item.note
if (!note && item.dormant) {
	note = "This account is dormant. I have access on it but I seldom used this account. It may be used before, or just reserved for special occassions."
}
---

<A unset href={item.url} target="_blank" rel="me" class="text-black border border-gray-300 hover:bg-gray-100 focus:bg-gray-100 active:bg-gray-200 focus:ring focus:ring-blue-500 focus:outline-none active:outline-none rounded grow flex flex-row justify-center items-center p-4" data-note={note} aria-label={`${item.username} on ${item.site}. Note: ${note}`} {...props}>
	{
		(item.icon || item.iconImg) && <div class="mr-4">
			{item.icon && <Icon name={item.icon} class="w-12 h-12" style={item?.iconStyle} />}
			{item.iconImg && <img src={item.iconImg} alt="" class="w-12 h-12" style={item?.iconStyle} />}
		</div>
	}
	<div class="grow">
		<p class="text-xl font-semibold">{item.site}</p>
		<p class="text-sm">{item.username} {item.dormant && <Icon name='bi:moon-fill' class="inline align-[-.125rem]" />}</p>
	</div>
</A>
